rule multi_allele:
  input:
    "{sample}.rg.{chr}.freebayes.vcf.gz"
  output:
    "{sample}.rg.{chr}.freebayes.unique.vcf.gz"
  threads: 5
  log:
    "{sample}.{chr}.unique.log"
  shell:
    "bcftools norm --threads {threads} -m -any -f {config[reference]}  {input} -o {output} -O z 2> {log}"    
    
rule ann_dbsnp:
  input:
    "{sample}.rg.{chr}.freebayes.unique.vcf.gz"
  output:
    "{sample}.rg.{chr}.freebayes.unique.dbsnp.vcf.gz"
  shell:
    """
    SnpSift annotate {config[dbsnp]} {input}|bgzip > {output}
    """

rule snpeff:
  input:
    "{sample}.rg.{chr}.freebayes.unique.dbsnp.vcf.gz"
  output:
    "{sample}.rg.{chr}.freebayes.unique.dbsnp.ann.vcf.gz"
  log:
    "{sample}.{chr}.snpeff.log"
  threads: 2 
  shell:
    "snpEff -Xms25G -v {config[snpeff]} {input} 2> {log} |bgzip > {output} "
    
rule spatial_variant:
  input:
    bam ="{sample}.rg.{chr}.bam",
    vcf= "{sample}.rg.{chr}.freebayes.unique.dbsnp.ann.vcf.gz"
  output:
    "{sample}.{chr}.spatial_variant.parquet"
  shell:
    "python {workflow.basedir}/scripts/create_space_variant.py {input.bam} {input.vcf} {output}" 
  
