

rule root:
  input:
    expand("pancreas.{chr}.spatial_variant.parquet", chr= [f"chr{i}" for i in range(1,22)])
     

rule read_group:
  input:
    "{sample}.bam"
  output:
    "{sample}.rg.bam"
  threads: 20
  shell:
    "samtools addreplacerg -@{threads} -r '@RG\tID:1\tSM:{wildcards.sample}\tPL:ILLUMINA\tLB:lib1\tPU:unit1' -o {output} {input}"

rule index:
  input:
    "{filename}.bam"
  output:
    "{filename}.bam.bai"
  shell:
    "samtools index {input}"

rule vcf_index:
    input:
      "{filename}.vcf.gz"
    output:
      "{filename}.vcf.gz.tbi"
    shell:
      "tabix -p vcf {input}"

rule freebayes:
    input:
      bam="{sample}.rg.{chr}.bam",
      bai="{sample}.rg.{chr}.bam.bai"
    output:
      "{sample}.rg.{chr}.freebayes.vcf.gz"
    shell:
      "freebayes -f {config[reference]} --min-coverage {config[min_dp]} --min-alternate-count {config[min_ao]} {input.bam} |bgzip > {output} "
      
rule bam_chromosome:
  input:
    "{sample}.rg.bam"
  output:
    "{sample}.rg.{chr}.bam"

  shell:
    """
    samtools view -OBam {input} {wildcards.chr} > {output}
    """



