    

rule read_group:
  input:
    "{sample}.bam"
  output:
    "{sample}.rg.bam"
  threads: 20
  shell:
    "samtools addreplacerg -@{threads} -r '@RG\tID:1\tSM:{wildcards.sample}\tPL:ILLUMINA\tLB:lib1\tPU:unit1' -o {output} {input}"

rule index:
  input:
    "{filename}.bam"
  output:
    "{filename}.bam.bai"
  shell:
    "samtools index {input}"

rule vcf_index:
    input:
      "{filename}.vcf.gz"
    output:
      "{filename}.vcf.gz.tbi"
    shell:
      "tabix -p vcf {input}"

rule freebayes:
    input:
      bam="{sample}.rg.{chr}.bam",
      bai="{sample}.rg.{chr}.bam.bai"
    output:
      "{sample}.rg.{chr}.freebayes.vcf.gz"
    shell:
      "freebayes -f {config[reference]} --min-coverage {config[min_dp]} --min-alternate-count {config[min_ao]} {input.bam} |bgzip > {output} "
      
rule bam_chromosome:
  input:
    "{sample}.rg.bam"
  output:
    "{sample}.rg.{chr}.bam"

  shell:
    """
    samtools view -OBam {input} {wildcards.chr} > {output}
    """



rule merge_vcf:
  input:
    bam=expand("{sample}.rg.{chr}.freebayes.vcf.gz", chr= [f"chr{i}" for i in range(1,22)], allow_missing=True),
    bai=expand("{sample}.rg.{chr}.freebayes.vcf.gz.tbi", chr= [f"chr{i}" for i in range(1,22)], allow_missing=True)

  output:
    "{sample}.freebayes.all.vcf.gz"
  shell:
    "bcftools concat -a -Oz {input.bam}  > {output}"

rule multi_allele:
  input:
    "{sample}.freebayes.all.vcf.gz"
  output:
    "{sample}.freebayes.all.unique.vcf.gz"
  threads: 20
  shell:
    "bcftools norm --threads {threads} -m -any -f {config[reference]}  {input} -o {output} -O z "    
    
rule ann_dbsnp:
  input:
    "{sample}.freebayes.all.unique.vcf.gz"
  output:
    "{sample}.freebayes.all.unique.dbsnp.vcf.gz"
  shell:
    """
    SnpSift annotate {config[dbsnp]} {input}|bgzip > {output}
    """

rule annotation:
  input:
    "{sample}.freebayes.all.unique.dbsnp.vcf.gz"
  output:
    "{sample}.freebayes.all.unique.dbsnp.ann.vcf.gz"
  log:
    "{sample}.snpeff.log"
  shell:
    "snpEff -Xms50G -v {config[snpeff]} {input} 2> {log} |bgzip > {output} "
    
rule spatial_variant:
  input:
    bam ="{sample}.rg.bam",
    vcf= "{sample}.freebayes.all.unique.dbsnp.ann.vcf.gz"
  output:
    "{sample}.spatial_variant.parquet"
  shell:
    "python {workflow.basedir}/scripts/create_space_variant.py {input.bam} {input.vcf} {output}" 
  
